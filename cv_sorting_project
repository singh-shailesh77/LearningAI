class TextExtractor:
    def extract(self, path: Path) -> str:
        suffix = path.suffix.lower()
        if suffix == ".pdf":
            return self._extract_pdf(path)
        if suffix == ".docx":
            return self._extract_docx(path)
        if suffix in {".txt", ".md"}:
            return path.read_text(encoding="utf-8", errors="ignore")
        raise ValueError(f"Unsupported file type: {path.suffix}")

    def _extract_pdf(self, path: Path) -> str:
        try:
            import PyPDF2
        except ImportError as exc:
            raise ImportError("PyPDF2 is required to parse PDF files.") from exc

        pages = []
        with open(path, "rb") as file_handle:
            reader = PyPDF2.PdfReader(file_handle)
            for page in reader.pages:
                pages.append(page.extract_text() or "")
        return "\n".join(pages)

    def _extract_docx(self, path: Path) -> str:
        try:
            import docx
        except ImportError as exc:
            raise ImportError("python-docx is required to parse DOCX files.") from exc

        document = docx.Document(str(path))
        return "\n".join(paragraph.text for paragraph in document.paragraphs)


class ResumeParserService:
    SKILL_CATALOG = HeuristicLLMEngine.COMMON_SKILLS

    def __init__(self, extractor: TextExtractor):
        self.extractor = extractor

    def parse_resumes(self, resumes_dir: str, max_resumes: int = 10) -> List[ResumeData]:
        resume_files = [
            path for path in sorted(Path(resumes_dir).glob("*"))
            if path.is_file() and path.suffix.lower() in {".pdf", ".docx", ".txt", ".md"}
        ]

        if len(resume_files) == 0:
            raise ValueError(f"No resume files found in {resumes_dir}")

        selected_files = resume_files[:max_resumes]
        parsed_resumes = [self.parse_single_resume(path) for path in selected_files]
        return parsed_resumes

    def parse_single_resume(self, path: Path) -> ResumeData:
        raw_text = self.extractor.extract(path)
        lines = [line.strip() for line in raw_text.splitlines() if line.strip()]

        return ResumeData(
            candidate_id=path.stem,
            file_name=path.name,
            name=self._extract_name(lines, path.stem),
            email=self._extract_email(raw_text),
            phone=self._extract_phone(raw_text),
            skills=self._extract_skills(raw_text),
            education=self._extract_section_items(raw_text, ["education", "academic", "qualification"]),
            certifications=self._extract_section_items(raw_text, ["certification", "certifications"]),
            experience_years=self._estimate_experience_years(raw_text),
            sections=self._extract_sections(raw_text),
            raw_text=raw_text,
        )

    def _extract_name(self, lines: List[str], default_name: str) -> str:
        if not lines:
            return default_name
        first_line = lines[0]
        if len(first_line.split()) <= 6 and not re.search(r"[@\d]", first_line):
            return first_line
        return default_name

    def _extract_email(self, text: str) -> Optional[str]:
        match = re.search(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", text)
        return match.group(0) if match else None

    def _extract_phone(self, text: str) -> Optional[str]:
        match = re.search(r"(\+?\d[\d\-\s]{8,}\d)", text)
        return match.group(0).strip() if match else None

    def _extract_skills(self, text: str) -> List[str]:
        lower = text.lower()
        found = sorted(skill for skill in self.SKILL_CATALOG if skill in lower)
        return found

    def _estimate_experience_years(self, text: str) -> float:
        lower = text.lower()
        patterns = [
            r"(\d+(?:\.\d+)?)\+?\s+years? of experience",
            r"experience[:\s]+(\d+(?:\.\d+)?)\+?\s+years?",
            r"(\d+(?:\.\d+)?)\+?\s+years? experience",
        ]
        for pattern in patterns:
            match = re.search(pattern, lower)
            if match:
                return float(match.group(1))

        year_matches = re.findall(r"\b(20\d{2}|19\d{2})\b", text)
        if len(year_matches) >= 2:
            years = sorted(int(y) for y in year_matches)
            approx = max(years) - min(years)
            if 0 < approx <= 40:
                return float(approx)
        return 0.0

    def _extract_section_items(self, text: str, section_names: List[str]) -> List[str]:
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        items = []
        active = False
        for line in lines:
            lowered = line.lower().rstrip(":")
            if any(name in lowered for name in section_names):
                active = True
                continue
            if active and self._is_section_heading(lowered):
                break
            if active:
                items.append(line)
        return items[:10]

    def _extract_sections(self, text: str) -> Dict[str, List[str]]:
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        sections: Dict[str, List[str]] = {}
        current = "general"
        sections[current] = []
        for line in lines:
            lowered = line.lower().rstrip(":")
            if self._is_section_heading(lowered):
                current = lowered
                sections.setdefault(current, [])
                continue
            sections.setdefault(current, []).append(line)
        return sections

    def _is_section_heading(self, line: str) -> bool:
        headings = {
            "summary", "profile", "skills", "technical skills", "experience", "work experience",
            "projects", "education", "certifications", "achievements", "internships", "contact"
        }
        return line in headings or (len(line.split()) <= 3 and line.isalpha())


class JobDescriptionParserService:
    def __init__(self, matching_engine: MatchingEngine):
        self.matching_engine = matching_engine

    def parse_job_description(self, path: str) -> JobDescriptionData:
        raw_text = Path(path).read_text(encoding="utf-8", errors="ignore")
        return self.matching_engine.parse_job_description(raw_text)


