        "from __future__ import annotations\n",
        "\n",
        "import argparse\n",
        "import csv\n",
        "import json\n",
        "import logging\n",
        "import os\n",
        "import re\n",
        "import sys\n",
        "from dataclasses import dataclass, asdict, field\n",
        "from pathlib import Path\n",
        "from typing import Any, Dict, List, Optional, Protocol\n",
        "\n",
        "logging.basicConfig(\n",
        "    level=logging.INFO,\n",
        "    format=\"%(asctime)s | %(levelname)s | %(name)s | %(message)s\",\n",
        ")\n",
        "logger = logging.getLogger(\"cv_sorting\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Configuration\n",
        "# ============================================================\n",
        "\n",
        "@dataclass\n",
        "class ProjectConfig:\n",
        "    resumes_dir: str = \"data/resumes\"\n",
        "    job_description_path: str = \"data/job_description.txt\"\n",
        "    output_dir: str = \"output\"\n",
        "    ranking_json_name: str = \"ranked_candidates.json\"\n",
        "    ranking_csv_name: str = \"ranked_candidates.csv\"\n",
        "    ranking_txt_name: str = \"ranked_candidates.txt\"\n",
        "    llm_backend: str = \"heuristic\"  # heuristic | ollama\n",
        "    ollama_model: str = \"llama3.1:8b\"\n",
        "    temperature: float = 0.1\n",
        "    max_resumes: int = 10\n",
        "\n",
        "    @property\n",
        "    def ranking_json_path(self) -> Path:\n",
        "        return Path(self.output_dir) / self.ranking_json_name\n",
        "\n",
        "    @property\n",
        "    def ranking_csv_path(self) -> Path:\n",
        "        return Path(self.output_dir) / self.ranking_csv_name\n",
        "\n",
        "    @property\n",
        "    def ranking_txt_path(self) -> Path:\n",
        "        return Path(self.output_dir) / self.ranking_txt_name\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Domain Models\n",
        "# ============================================================\n",
        "\n",
        "@dataclass\n",
        "class ResumeData:\n",
        "    candidate_id: str\n",
        "    file_name: str\n",
        "    name: str\n",
        "    email: Optional[str]\n",
        "    phone: Optional[str]\n",
        "    skills: List[str] = field(default_factory=list)\n",
        "    education: List[str] = field(default_factory=list)\n",
        "    certifications: List[str] = field(default_factory=list)\n",
        "    experience_years: float = 0.0\n",
        "    sections: Dict[str, List[str]] = field(default_factory=dict)\n",
        "    raw_text: str = \"\"\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class JobRequirement:\n",
        "    requirement: str\n",
        "    category: str\n",
        "    priority: str\n",
        "    weight: float\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class JobDescriptionData:\n",
        "    title: str\n",
        "    required_skills: List[str]\n",
        "    preferred_skills: List[str]\n",
        "    responsibilities: List[str]\n",
        "    qualifications: List[str]\n",
        "    keywords: List[str]\n",
        "    requirements: List[JobRequirement]\n",
        "    raw_text: str\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class RequirementScore:\n",
        "    requirement: str\n",
        "    category: str\n",
        "    score: float\n",
        "    max_score: float\n",
        "    evidence: str\n",
        "    gap: str\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class CandidateMatchResult:\n",
        "    rank: int\n",
        "    candidate_id: str\n",
        "    file_name: str\n",
        "    candidate_name: str\n",
        "    overall_score: float\n",
        "    recommendation: str\n",
        "    matched_skills: List[str]\n",
        "    missing_skills: List[str]\n",
        "    experience_years: float\n",
        "    summary: str\n",
        "    requirement_scores: List[RequirementScore]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# LLM Abstractions\n",
        "# ============================================================\n",
        "\n",
        "class MatchingEngine(Protocol):\n",
        "    def parse_job_description(self, raw_text: str) -> JobDescriptionData:\n",
        "        ...\n",
        "\n",
        "    def evaluate_candidate(\n",
        "        self,\n",
        "        resume: ResumeData,\n",
        "        job_description: JobDescriptionData,\n",
        "    ) -> CandidateMatchResult:\n",
        "        ...\n",
        "\n",
        "\n",
        "class HeuristicLLMEngine:\n",
        "    \"\"\"\n",
        "    Offline-friendly engine that imitates LLM-style reasoning using deterministic scoring.\n",
        "    Useful for capstone demos when an actual open-source LLM is unavailable.\n",
        "    \"\"\"\n",
        "\n",
        "    COMMON_SKILLS = {\n",
        "        \"python\", \"java\", \"sql\", \"mongodb\", \"postgresql\", \"mysql\", \"aws\", \"azure\",\n",
        "        \"gcp\", \"docker\", \"kubernetes\", \"git\", \"github\", \"linux\", \"fastapi\", \"flask\",\n",
        "        \"django\", \"pandas\", \"numpy\", \"scikit-learn\", \"tensorflow\", \"pytorch\", \"spark\",\n",
        "        \"hadoop\", \"nlp\", \"machine learning\", \"deep learning\", \"transformers\", \"langchain\",\n",
        "        \"llm\", \"llms\", \"prompt engineering\", \"rag\", \"llamaindex\", \"data analysis\",\n",
        "        \"power bi\", \"tableau\", \"excel\", \"communication\", \"leadership\", \"streamlit\"\n",
        "    }\n",
        "\n",
        "    PRIORITY_WEIGHTS = {\n",
        "        \"high\": 1.5,\n",
        "        \"medium\": 1.0,\n",
        "        \"low\": 0.6,\n",
        "    }\n",
        "\n",
        "    def parse_job_description(self, raw_text: str) -> JobDescriptionData:\n",
        "        title = self._extract_title(raw_text)\n",
        "        bullet_lines = self._extract_bullets(raw_text)\n",
        "        normalized_text = self._normalize_space(raw_text.lower())\n",
        "        skills = sorted(self._extract_skills(normalized_text))\n",
        "\n",
        "        required_skills = []\n",
        "        preferred_skills = []\n",
        "        responsibilities = []\n",
        "        qualifications = []\n",
        "        requirements = []\n",
        "\n",
        "        for line in bullet_lines:\n",
        "            lower = line.lower()\n",
        "            if any(token in lower for token in [\"must\", \"required\", \"mandatory\"]):\n",
        "                qualifications.append(line)\n",
        "                found_skills = self._extract_skills(lower)\n",
        "                required_skills.extend(found_skills)\n",
        "                requirements.append(\n",
        "                    JobRequirement(\n",
        "                        requirement=line,\n",
        "                        category=self._infer_requirement_category(line),\n",
        "                        priority=\"high\",\n",
        "                        weight=1.5,\n",
        "                    )\n",
        "                )\n",
        "            elif any(token in lower for token in [\"preferred\", \"good to have\", \"nice to have\", \"plus\"]):\n",
        "                qualifications.append(line)\n",
        "                found_skills = self._extract_skills(lower)\n",
        "                preferred_skills.extend(found_skills)\n",
        "                requirements.append(\n",
        "                    JobRequirement(\n",
        "                        requirement=line,\n",
        "                        category=self._infer_requirement_category(line),\n",
        "                        priority=\"medium\",\n",
        "                        weight=1.0,\n",
        "                    )\n",
        "                )\n",
        "            elif any(token in lower for token in [\"responsible\", \"responsibilities\", \"design\", \"develop\", \"build\", \"deploy\", \"maintain\"]):\n",
        "                responsibilities.append(line)\n",
        "                requirements.append(\n",
        "                    JobRequirement(\n",
        "                        requirement=line,\n",
        "                        category=\"responsibility\",\n",
        "                        priority=\"medium\",\n",
        "                        weight=1.0,\n",
        "                    )\n",
        "                )\n",
        "            else:\n",
        "                found_skills = self._extract_skills(lower)\n",
        "                if found_skills:\n",
        "                    required_skills.extend(found_skills)\n",
        "                requirements.append(\n",
        "                    JobRequirement(\n",
        "                        requirement=line,\n",
        "                        category=self._infer_requirement_category(line),\n",
        "                        priority=\"medium\",\n",
        "                        weight=1.0,\n",
        "                    )\n",
        "                )\n",
        "\n",
        "        if not requirements:\n",
        "            for sentence in self._split_sentences(raw_text):\n",
        "                sentence = sentence.strip()\n",
        "                if not sentence:\n",
        "                    continue\n",
        "                requirements.append(\n",
        "                    JobRequirement(\n",
        "                        requirement=sentence,\n",
        "                        category=self._infer_requirement_category(sentence),\n",
        "                        priority=\"medium\",\n",
        "                        weight=1.0,\n",
        "                    )\n",
        "                )\n",
        "\n",
        "        required_skills = sorted(set(required_skills or skills))\n",
        "        preferred_skills = sorted(set(preferred_skills))\n",
        "        keywords = sorted(set(skills + required_skills + preferred_skills))\n",
        "\n",
        "        return JobDescriptionData(\n",
        "            title=title,\n",
        "            required_skills=required_skills,\n",
        "            preferred_skills=preferred_skills,\n",
        "            responsibilities=responsibilities,\n",
        "            qualifications=qualifications,\n",
        "            keywords=keywords,\n",
        "            requirements=requirements,\n",
        "            raw_text=raw_text,\n",
        "        )\n",
        "\n",
        "    def evaluate_candidate(\n",
        "        self,\n",
        "        resume: ResumeData,\n",
        "        job_description: JobDescriptionData,\n",
        "    ) -> CandidateMatchResult:\n",
        "        matched_skills = sorted(set(resume.skills) & set(job_description.required_skills + job_description.preferred_skills))\n",
        "        missing_skills = sorted(set(job_description.required_skills) - set(resume.skills))\n",
        "\n",
        "        requirement_scores: List[RequirementScore] = []\n",
        "        weighted_total = 0.0\n",
        "        weighted_max = 0.0\n",
        "\n",
        "        for requirement in job_description.requirements:\n",
        "            score, evidence, gap = self._score_requirement(requirement, resume)\n",
        "            max_score = 10.0\n",
        "            weight = requirement.weight * self.PRIORITY_WEIGHTS.get(requirement.priority, 1.0)\n",
        "            weighted_total += score * weight\n",
        "            weighted_max += max_score * weight\n",
        "            requirement_scores.append(\n",
        "                RequirementScore(\n",
        "                    requirement=requirement.requirement,\n",
        "                    category=requirement.category,\n",
        "                    score=round(score, 2),\n",
        "                    max_score=max_score,\n",
        "                    evidence=evidence,\n",
        "                    gap=gap,\n",
        "                )\n",
        "            )\n",
        "\n",
        "        skill_coverage = 0.0\n",
        "        if job_description.required_skills:\n",
        "            skill_coverage = len(set(resume.skills) & set(job_description.required_skills)) / len(set(job_description.required_skills))\n",
        "\n",
        "        experience_bonus = min(resume.experience_years / 8.0, 1.0) * 10.0\n",
        "        blended_score = ((weighted_total / weighted_max) * 90.0) + experience_bonus if weighted_max else experience_bonus\n",
        "        blended_score += skill_coverage * 10.0\n",
        "        overall_score = min(round(blended_score, 2), 100.0)\n",
        "\n",
        "        recommendation = self._recommendation(overall_score)\n",
        "        summary = self._build_summary(\n",
        "            resume=resume,\n",
        "            job_description=job_description,\n",
        "            matched_skills=matched_skills,\n",
        "            missing_skills=missing_skills,\n",
        "            overall_score=overall_score,\n",
        "        )\n",
        "\n",
        "        return CandidateMatchResult(\n",
        "            rank=0,\n",
        "            candidate_id=resume.candidate_id,\n",
        "            file_name=resume.file_name,\n",
        "            candidate_name=resume.name,\n",
        "            overall_score=overall_score,\n",
        "            recommendation=recommendation,\n",
        "            matched_skills=matched_skills,\n",
        "            missing_skills=missing_skills,\n",
        "            experience_years=resume.experience_years,\n",
        "            summary=summary,\n",
        "            requirement_scores=requirement_scores,\n",
        "        )\n",
        "\n",
        "    def _score_requirement(self, requirement: JobRequirement, resume: ResumeData) -> tuple[float, str, str]:\n",
        "        requirement_text = requirement.requirement.lower()\n",
        "        resume_text = resume.raw_text.lower()\n",
        "        requirement_skills = self._extract_skills(requirement_text)\n",
        "\n",
        "        if requirement_skills:\n",
        "            matched = sorted(set(requirement_skills) & set(resume.skills))\n",
        "            missing = sorted(set(requirement_skills) - set(resume.skills))\n",
        "            ratio = len(matched) / len(requirement_skills)\n",
        "            score = ratio * 10.0\n",
        "            evidence = (\n",
        "                f\"Matched skills: {', '.join(matched)}\"\n",
        "                if matched else\n",
        "                \"No explicit matching skill found in resume.\"\n",
        "            )\n",
        "            gap = (\n",
        "                f\"Missing skills: {', '.join(missing)}\"\n",
        "                if missing else\n",
        "                \"No major skill gap for this requirement.\"\n",
        "            )\n",
        "            return score, evidence, gap\n",
        "\n",
        "        overlap_tokens = self._token_overlap(requirement_text, resume_text)\n",
        "        if overlap_tokens >= 8:\n",
        "            return 8.0, \"Strong textual alignment with candidate experience.\", \"No obvious gap detected.\"\n",
        "        if overlap_tokens >= 4:\n",
        "            return 6.0, \"Moderate alignment found in resume narrative.\", \"More direct evidence could strengthen fit.\"\n",
        "        if overlap_tokens >= 2:\n",
        "            return 4.0, \"Partial relevance found in resume content.\", \"Requirement is not strongly demonstrated.\"\n",
        "        return 2.0, \"Very limited evidence found for this requirement.\", \"Requirement appears weakly supported in the resume.\"\n",
        "\n",
        "    def _build_summary(\n",
        "        self,\n",
        "        resume: ResumeData,\n",
        "        job_description: JobDescriptionData,\n",
        "        matched_skills: List[str],\n",
        "        missing_skills: List[str],\n",
        "        overall_score: float,\n",
        "    ) -> str:\n",
        "        matched_part = \", \".join(matched_skills[:6]) if matched_skills else \"limited direct skill overlap\"\n",
        "        missing_part = \", \".join(missing_skills[:5]) if missing_skills else \"no major required skill gaps\"\n",
        "        return (\n",
        "            f\"{resume.name} shows {resume.experience_years:.1f} years of estimated experience. \"\n",
        "            f\"The profile aligns with the role through {matched_part}. \"\n",
        "            f\"The main gaps are {missing_part}. \"\n",
        "            f\"Overall fit is assessed at {overall_score}/100 for the target role '{job_description.title}'.\"\n",
        "        )\n",
        "\n",
        "    def _recommendation(self, score: float) -> str:\n",
        "        if score >= 80:\n",
        "            return \"Strong Fit\"\n",
        "        if score >= 60:\n",
        "            return \"Moderate Fit\"\n",
        "        return \"Weak Fit\"\n",
        "\n",
        "    def _extract_title(self, raw_text: str) -> str:\n",
        "        lines = [line.strip() for line in raw_text.splitlines() if line.strip()]\n",
        "        return lines[0] if lines else \"Job Role\"\n",
        "\n",
        "    def _extract_bullets(self, raw_text: str) -> List[str]:\n",
        "        lines = [line.strip(\" -•\\t\") for line in raw_text.splitlines() if line.strip()]\n",
        "        bullets = [line for line in lines if len(line.split()) >= 3]\n",
        "        return bullets\n",
        "\n",
        "    def _extract_skills(self, text: str) -> set[str]:\n",
        "        found = set()\n",
        "        for skill in self.COMMON_SKILLS:\n",
        "            if skill in text:\n",
        "                found.add(skill)\n",
        "        return found\n",
        "\n",
        "    def _infer_requirement_category(self, text: str) -> str:\n",
        "        lower = text.lower()\n",
        "        if any(token in lower for token in [\"skill\", \"python\", \"sql\", \"llm\", \"langchain\", \"aws\", \"docker\"]):\n",
        "            return \"skill\"\n",
        "        if any(token in lower for token in [\"year\", \"experience\"]):\n",
        "            return \"experience\"\n",
        "        if any(token in lower for token in [\"degree\", \"bachelor\", \"master\", \"education\"]):\n",
        "            return \"education\"\n",
        "        if any(token in lower for token in [\"responsible\", \"design\", \"develop\", \"build\", \"deploy\"]):\n",
        "            return \"responsibility\"\n",
        "        return \"general\"\n",
        "\n",
        "    def _split_sentences(self, text: str) -> List[str]:\n",
        "        return re.split(r\"(?<=[.!?])\\s+\", self._normalize_space(text))\n",
        "\n",
        "    def _normalize_space(self, text: str) -> str:\n",
        "        return re.sub(r\"\\s+\", \" \", text).strip()\n",
        "\n",
        "    def _token_overlap(self, a: str, b: str) -> int:\n",
        "        stop = {\"the\", \"and\", \"or\", \"to\", \"of\", \"for\", \"with\", \"in\", \"a\", \"an\", \"on\", \"is\", \"are\"}\n",
        "        tokens_a = {t for t in re.findall(r\"[a-zA-Z]{3,}\", a) if t not in stop}\n",
        "        tokens_b = {t for t in re.findall(r\"[a-zA-Z]{3,}\", b) if t not in stop}\n",
        "        return len(tokens_a & tokens_b)\n",
        "\n",
        "\n",
        "class OllamaLLMEngine(HeuristicLLMEngine):\n",
        "    \"\"\"\n",
        "    Uses an Ollama-hosted open-source LLM for JD parsing and candidate evaluation.\n",
        "    Falls back to heuristic processing if the model response is invalid.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, model_name: str, temperature: float = 0.1):\n",
        "        self.model_name = model_name\n",
        "        self.temperature = temperature\n",
        "        try:\n",
        "            import requests\n",
        "        except ImportError as exc:\n",
        "            raise ImportError(\"requests is required for Ollama backend.\") from exc\n",
        "        self.requests = requests\n",
        "\n",
        "    def parse_job_description(self, raw_text: str) -> JobDescriptionData:\n",
        "        prompt = self._job_description_prompt(raw_text)\n",
        "        response = self._generate(prompt)\n",
        "        payload = self._safe_json(response)\n",
        "        if not payload:\n",
        "            return super().parse_job_description(raw_text)\n",
        "\n",
        "        requirements = []\n",
        "        for item in payload.get(\"requirements\", []):\n",
        "            if not item.get(\"requirement\"):\n",
        "                continue\n",
        "            requirements.append(\n",
        "                JobRequirement(\n",
        "                    requirement=item.get(\"requirement\", \"\"),\n",
        "                    category=item.get(\"category\", \"general\"),\n",
        "                    priority=item.get(\"priority\", \"medium\"),\n",
        "                    weight=float(item.get(\"weight\", 1.0)),\n",
        "                )\n",
        "            )\n",
        "\n",
        "        return JobDescriptionData(\n",
        "            title=payload.get(\"title\", \"Job Role\"),\n",
        "            required_skills=self._normalize_list(payload.get(\"required_skills\", [])),\n",
        "            preferred_skills=self._normalize_list(payload.get(\"preferred_skills\", [])),\n",
        "            responsibilities=self._normalize_list(payload.get(\"responsibilities\", [])),\n",
        "            qualifications=self._normalize_list(payload.get(\"qualifications\", [])),\n",
        "            keywords=self._normalize_list(payload.get(\"keywords\", [])),\n",
        "            requirements=requirements or super().parse_job_description(raw_text).requirements,\n",
        "            raw_text=raw_text,\n",
        "        )\n",
        "\n",
        "    def evaluate_candidate(\n",
        "        self,\n",
        "        resume: ResumeData,\n",
        "        job_description: JobDescriptionData,\n",
        "    ) -> CandidateMatchResult:\n",
        "        prompt = self._candidate_evaluation_prompt(resume, job_description)\n",
        "        response = self._generate(prompt)\n",
        "        payload = self._safe_json(response)\n",
        "        if not payload:\n",
        "            return super().evaluate_candidate(resume, job_description)\n",
        "\n",
        "        requirement_scores = []\n",
        "        for item in payload.get(\"requirement_scores\", []):\n",
        "            requirement_scores.append(\n",
        "                RequirementScore(\n",
        "                    requirement=item.get(\"requirement\", \"\"),\n",
        "                    category=item.get(\"category\", \"general\"),\n",
        "                    score=float(item.get(\"score\", 0)),\n",
        "                    max_score=float(item.get(\"max_score\", 10)),\n",
        "                    evidence=item.get(\"evidence\", \"\"),\n",
        "                    gap=item.get(\"gap\", \"\"),\n",
        "                )\n",
        "            )\n",
        "\n",
        "        return CandidateMatchResult(\n",
        "            rank=0,\n",
        "            candidate_id=resume.candidate_id,\n",
        "            file_name=payload.get(\"file_name\", resume.file_name),\n",
        "            candidate_name=payload.get(\"candidate_name\", resume.name),\n",
        "            overall_score=float(payload.get(\"overall_score\", 0)),\n",
        "            recommendation=payload.get(\"recommendation\", \"Moderate Fit\"),\n",
        "            matched_skills=self._normalize_list(payload.get(\"matched_skills\", [])),\n",
        "            missing_skills=self._normalize_list(payload.get(\"missing_skills\", [])),\n",
        "            experience_years=resume.experience_years,\n",
        "            summary=payload.get(\"summary\", \"\"),\n",
        "            requirement_scores=requirement_scores,\n",
        "        )\n",
        "\n",
        "    def _generate(self, prompt: str) -> str:\n",
        "        response = self.requests.post(\n",
        "            \"http://localhost:11434/api/generate\",\n",
        "            json={\n",
        "                \"model\": self.model_name,\n",
        "                \"prompt\": prompt,\n",
        "                \"stream\": False,\n",
        "                \"options\": {\"temperature\": self.temperature},\n",
        "            },\n",
        "            timeout=120,\n",
        "        )\n",
        "        response.raise_for_status()\n",
        "        data = response.json()\n",
        "        return data.get(\"response\", \"\")\n",
        "\n",
        "    def _job_description_prompt(self, raw_text: str) -> str:\n",
        "        return f\"\"\"\n",
        "You are a recruitment analyst.\n",
        "Extract structured job data and return JSON only.\n",
        "Schema:\n",
        "{{\n",
        "  \"title\": \"string\",\n",
        "  \"required_skills\": [\"string\"],\n",
        "  \"preferred_skills\": [\"string\"],\n",
        "  \"responsibilities\": [\"string\"],\n",
        "  \"qualifications\": [\"string\"],\n",
        "  \"keywords\": [\"string\"],\n",
        "  \"requirements\": [\n",
        "    {{\"requirement\": \"string\", \"category\": \"string\", \"priority\": \"high|medium|low\", \"weight\": 1.0}}\n",
        "  ]\n",
        "}}\n",
        "Job Description:\n",
        "{raw_text}\n",
        "\"\"\".strip()\n",
        "\n",
        "    def _candidate_evaluation_prompt(self, resume: ResumeData, job_description: JobDescriptionData) -> str:\n",
        "        return f\"\"\"\n",
        "You are an expert resume screener.\n",
        "Evaluate the candidate against the job description and return JSON only.\n",
        "Use only the provided data.\n",
        "Schema:\n",
        "{{\n",
        "  \"candidate_name\": \"string\",\n",
        "  \"overall_score\": 0,\n",
        "  \"recommendation\": \"Strong Fit|Moderate Fit|Weak Fit\",\n",
        "  \"matched_skills\": [\"string\"],\n",
        "  \"missing_skills\": [\"string\"],\n",
        "  \"summary\": \"string\",\n",
        "  \"requirement_scores\": [\n",
        "    {{\n",
        "      \"requirement\": \"string\",\n",
        "      \"category\": \"string\",\n",
        "      \"score\": 0,\n",
        "      \"max_score\": 10,\n",
        "      \"evidence\": \"string\",\n",
        "      \"gap\": \"string\"\n",
        "    }}\n",
        "  ]\n",
        "}}\n",
        "Job Description JSON:\n",
        "{json.dumps(asdict(job_description), indent=2)}\n",
        "Resume JSON:\n",
        "{json.dumps(asdict(resume), indent=2)}\n",
        "\"\"\".strip()\n",
        "\n",
        "    def _safe_json(self, text: str) -> Dict[str, Any]:\n",
        "        try:\n",
        "            match = re.search(r\"\\{.*\\}\", text, re.DOTALL)\n",
        "            if match:\n",
        "                text = match.group(0)\n",
        "            return json.loads(text)\n",
        "        except Exception:\n",
        "            logger.warning(\"Invalid JSON from Ollama. Falling back to heuristic engine.\")\n",
        "            return {}\n",
        "\n",
        "    def _normalize_list(self, value: Any) -> List[str]:\n",
        "        if isinstance(value, list):\n",
        "            return [str(v).strip() for v in value if str(v).strip()]\n",
        "        if isinstance(value, str):\n",
        "            return [part.strip() for part in re.split(r\"[,;\\n]\", value) if part.strip()]\n",
        "        return []\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Parsing Services\n",
        "# ============================================================\n",
        "\n",
        "class TextExtractor:\n",
        "    def extract(self, path: Path) -> str:\n",
        "        suffix = path.suffix.lower()\n",
        "        if suffix == \".pdf\":\n",
        "            return self._extract_pdf(path)\n",
        "        if suffix == \".docx\":\n",
        "            return self._extract_docx(path)\n",
        "        if suffix in {\".txt\", \".md\"}:\n",
        "            return path.read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
        "        raise ValueError(f\"Unsupported file type: {path.suffix}\")\n",
        "\n",
        "    def _extract_pdf(self, path: Path) -> str:\n",
        "        try:\n",
        "            import PyPDF2\n",
        "        except ImportError as exc:\n",
        "            raise ImportError(\"PyPDF2 is required to parse PDF files.\") from exc\n",
        "\n",
        "        pages = []\n",
        "        with open(path, \"rb\") as file_handle:\n",
        "            reader = PyPDF2.PdfReader(file_handle)\n",
        "            for page in reader.pages:\n",
        "                pages.append(page.extract_text() or \"\")\n",
        "        return \"\\n\".join(pages)\n",
        "\n",
        "    def _extract_docx(self, path: Path) -> str:\n",
        "        try:\n",
        "            import docx\n",
        "        except ImportError as exc:\n",
        "            raise ImportError(\"python-docx is required to parse DOCX files.\") from exc\n",
        "\n",
        "        document = docx.Document(str(path))\n",
        "        return \"\\n\".join(paragraph.text for paragraph in document.paragraphs)\n",
        "\n",
        "\n",
        "class ResumeParserService:\n",
        "    SKILL_CATALOG = HeuristicLLMEngine.COMMON_SKILLS\n",
        "\n",
        "    def __init__(self, extractor: TextExtractor):\n",
        "        self.extractor = extractor\n",
        "\n",
        "    def parse_resumes(self, resumes_dir: str, max_resumes: int = 10) -> List[ResumeData]:\n",
        "        resume_files = [\n",
        "            path for path in sorted(Path(resumes_dir).glob(\"*\"))\n",
        "            if path.is_file() and path.suffix.lower() in {\".pdf\", \".docx\", \".txt\", \".md\"}\n",
        "        ]\n",
        "\n",
        "        if len(resume_files) == 0:\n",
        "            raise ValueError(f\"No resume files found in {resumes_dir}\")\n",
        "\n",
        "        selected_files = resume_files[:max_resumes]\n",
        "        parsed_resumes = [self.parse_single_resume(path) for path in selected_files]\n",
        "        return parsed_resumes\n",
        "\n",
        "    def parse_single_resume(self, path: Path) -> ResumeData:\n",
        "        raw_text = self.extractor.extract(path)\n",
        "        lines = [line.strip() for line in raw_text.splitlines() if line.strip()]\n",
        "\n",
        "        return ResumeData(\n",
        "            candidate_id=path.stem,\n",
        "            file_name=path.name,\n",
        "            name=self._extract_name(lines, path.stem),\n",
        "            email=self._extract_email(raw_text),\n",
        "            phone=self._extract_phone(raw_text),\n",
        "            skills=self._extract_skills(raw_text),\n",
        "            education=self._extract_section_items(raw_text, [\"education\", \"academic\", \"qualification\"]),\n",
        "            certifications=self._extract_section_items(raw_text, [\"certification\", \"certifications\"]),\n",
        "            experience_years=self._estimate_experience_years(raw_text),\n",
        "            sections=self._extract_sections(raw_text),\n",
        "            raw_text=raw_text,\n",
        "        )\n",
        "\n",
        "    def _extract_name(self, lines: List[str], default_name: str) -> str:\n",
        "        if not lines:\n",
        "            return default_name\n",
        "        first_line = lines[0]\n",
        "        if len(first_line.split()) <= 6 and not re.search(r\"[@\\d]\", first_line):\n",
        "            return first_line\n",
        "        return default_name\n",
        "\n",
        "    def _extract_email(self, text: str) -> Optional[str]:\n",
        "        match = re.search(r\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\", text)\n",
        "        return match.group(0) if match else None\n",
        "\n",
        "    def _extract_phone(self, text: str) -> Optional[str]:\n",
        "        match = re.search(r\"(\\+?\\d[\\d\\-\\s]{8,}\\d)\", text)\n",
        "        return match.group(0).strip() if match else None\n",
        "\n",
        "    def _extract_skills(self, text: str) -> List[str]:\n",
        "        lower = text.lower()\n",
        "        found = sorted(skill for skill in self.SKILL_CATALOG if skill in lower)\n",
        "        return found\n",
        "\n",
        "    def _estimate_experience_years(self, text: str) -> float:\n",
        "        lower = text.lower()\n",
        "        patterns = [\n",
        "            r\"(\\d+(?:\\.\\d+)?)\\+?\\s+years? of experience\",\n",
        "            r\"experience[:\\s]+(\\d+(?:\\.\\d+)?)\\+?\\s+years?\",\n",
        "            r\"(\\d+(?:\\.\\d+)?)\\+?\\s+years? experience\",\n",
        "        ]\n",
        "        for pattern in patterns:\n",
        "            match = re.search(pattern, lower)\n",
        "            if match:\n",
        "                return float(match.group(1))\n",
        "\n",
        "        year_matches = re.findall(r\"\\b(20\\d{2}|19\\d{2})\\b\", text)\n",
        "        if len(year_matches) >= 2:\n",
        "            years = sorted(int(y) for y in year_matches)\n",
        "            approx = max(years) - min(years)\n",
        "            if 0 < approx <= 40:\n",
        "                return float(approx)\n",
        "        return 0.0\n",
        "\n",
        "    def _extract_section_items(self, text: str, section_names: List[str]) -> List[str]:\n",
        "        lines = [line.strip() for line in text.splitlines() if line.strip()]\n",
        "        items = []\n",
        "        active = False\n",
        "        for line in lines:\n",
        "            lowered = line.lower().rstrip(\":\")\n",
        "            if any(name in lowered for name in section_names):\n",
        "                active = True\n",
        "                continue\n",
        "            if active and self._is_section_heading(lowered):\n",
        "                break\n",
        "            if active:\n",
        "                items.append(line)\n",
        "        return items[:10]\n",
        "\n",
        "    def _extract_sections(self, text: str) -> Dict[str, List[str]]:\n",
        "        lines = [line.strip() for line in text.splitlines() if line.strip()]\n",
        "        sections: Dict[str, List[str]] = {}\n",
        "        current = \"general\"\n",
        "        sections[current] = []\n",
        "        for line in lines:\n",
        "            lowered = line.lower().rstrip(\":\")\n",
        "            if self._is_section_heading(lowered):\n",
        "                current = lowered\n",
        "                sections.setdefault(current, [])\n",
        "                continue\n",
        "            sections.setdefault(current, []).append(line)\n",
        "        return sections\n",
        "\n",
        "    def _is_section_heading(self, line: str) -> bool:\n",
        "        headings = {\n",
        "            \"summary\", \"profile\", \"skills\", \"technical skills\", \"experience\", \"work experience\",\n",
        "            \"projects\", \"education\", \"certifications\", \"achievements\", \"internships\", \"contact\"\n",
        "        }\n",
        "        return line in headings or (len(line.split()) <= 3 and line.isalpha())\n",
        "\n",
        "\n",
        "class JobDescriptionParserService:\n",
        "    def __init__(self, matching_engine: MatchingEngine):\n",
        "        self.matching_engine = matching_engine\n",
        "\n",
        "    def parse_job_description(self, path: str) -> JobDescriptionData:\n",
        "        raw_text = Path(path).read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
        "        return self.matching_engine.parse_job_description(raw_text)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Ranking and Export Services\n",
        "# ============================================================\n",
        "\n",
        "class CandidateRankingService:\n",
        "    def rank_candidates(self, results: List[CandidateMatchResult]) -> List[CandidateMatchResult]:\n",
        "        ranked = sorted(results, key=lambda item: item.overall_score, reverse=True)\n",
        "        for index, result in enumerate(ranked, start=1):\n",
        "            result.rank = index\n",
        "        return ranked\n",
        "\n",
        "\n",
        "class OutputWriter:\n",
        "    def __init__(self, config: ProjectConfig):\n",
        "        self.config = config\n",
        "        output_path = Path(config.output_dir)\n",
        "        # If the output path exists and is not a directory (e.g., it's a file),\n",
        "        # remove it to allow creation of a directory.\n",
        "        if output_path.exists() and not output_path.is_dir():\n",
        "            logger.warning(f\"Removing existing non-directory entry at output path: {output_path}\")\n",
        "            output_path.unlink() # Remove the file or other non-directory entry\n",
        "        output_path.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    def write_all(self, ranked_results: List[CandidateMatchResult]) -> None:\n",
        "        self._write_json(ranked_results)\n",
        "        self._write_csv(ranked_results)\n",
        "        self._write_text_report(ranked_results)\n",
        "\n",
        "    def _write_json(self, ranked_results: List[CandidateMatchResult]) -> None:\n",
        "        serializable = []\n",
        "        for result in ranked_results:\n",
        "            item = asdict(result)\n",
        "            serializable.append(item)\n",
        "        self.config.ranking_json_path.write_text(\n",
        "            json.dumps(serializable, indent=2, ensure_ascii=False),\n",
        "            encoding=\"utf-8\",\n",
        "        )\n",
        "\n",
        "    def _write_csv(self, ranked_results: List[CandidateMatchResult]) -> None:\n",
        "        fieldnames = [\n",
        "            \"rank\",\n",
        "            \"candidate_id\",\n",
        "            \"file_name\",\n",
        "            \"candidate_name\",\n",
        "            \"overall_score\",\n",
        "            \"recommendation\",\n",
        "            \"experience_years\",\n",
        "            \"matched_skills\",\n",
        "            \"missing_skills\",\n",
        "            \"summary\",\n",
        "        ]\n",
        "        with open(self.config.ranking_csv_path, \"w\", newline=\"\", encoding=\"utf-8\") as file_handle:\n",
        "            writer = csv.DictWriter(file_handle, fieldnames=fieldnames)\n",
        "            writer.writeheader()\n",
        "            for result in ranked_results:\n",
        "                writer.writerow({\n",
        "                    \"rank\": result.rank,\n",
        "                    \"candidate_id\": result.candidate_id,\n",
        "                    \"file_name\": result.file_name,\n",
        "                    \"candidate_name\": result.candidate_name,\n",
        "                    \"overall_score\": result.overall_score,\n",
        "                    \"recommendation\": result.recommendation,\n",
        "                    \"experience_years\": result.experience_years,\n",
        "                    \"matched_skills\": \"; \".join(result.matched_skills),\n",
        "                    \"missing_skills\": \"; \".join(result.missing_skills),\n",
        "                    \"summary\": result.summary,\n",
        "                })\n",
        "\n",
        "    def _write_text_report(self, ranked_results: List[CandidateMatchResult]) -> None:\n",
        "        lines: List[str] = []\n",
        "        lines.append(\"CV Sorting Results\")\n",
        "        lines.append(\"=\" * 80)\n",
        "        lines.append(\"\")\n",
        "\n",
        "        for result in ranked_results:\n",
        "            lines.append(f\"Rank #{result.rank}: {result.candidate_name}\")\n",
        "            lines.append(f\"File: {result.file_name}\")\n",
        "            lines.append(f\"Overall Score: {result.overall_score}\")\n",
        "            lines.append(f\"Recommendation: {result.recommendation}\")\n",
        "            lines.append(f\"Estimated Experience (years): {result.experience_years}\")\n",
        "            lines.append(f\"Matched Skills: {', '.join(result.matched_skills) if result.matched_skills else 'None'}\")\n",
        "            lines.append(f\"Missing Skills: {', '.join(result.missing_skills) if result.missing_skills else 'None'}\")\n",
        "            lines.append(f\"Summary: {result.summary}\")\n",
        "            lines.append(\"Requirement Breakdown:\")\n",
        "            for req in result.requirement_scores:\n",
        "                lines.append(\n",
        "                    f\"  - [{req.category}] {req.requirement} | Score: {req.score}/{req.max_score} | \"\n",
        "                    f\"Evidence: {req.evidence} | Gap: {req.gap}\"\n",
        "                )\n",
        "            lines.append(\"-\" * 80)\n",
        "\n",
        "        self.config.ranking_txt_path.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Interactive Filtering Support\n",
        "# ============================================================\n",
        "\n",
        "class QueryRefinementService:\n",
        "    def filter_candidates(\n",
        "        self,\n",
        "        ranked_results: List[CandidateMatchResult],\n",
        "        required_skills: List[str],\n",
        "        minimum_score: float = 0.0,\n",
        "    ) -> List[CandidateMatchResult]:\n",
        "        required = {skill.lower() for skill in required_skills}\n",
        "        filtered = []\n",
        "        for result in ranked_results:\n",
        "            candidate_skills = {skill.lower() for skill in result.matched_skills}\n",
        "            if required.issubset(candidate_skills) and result.overall_score >= minimum_score:\n",
        "                filtered.append(result)\n",
        "        return filtered\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Main Pipeline\n",
        "# ============================================================\n",
        "\n",
        "class CVSortingPipeline:\n",
        "    def __init__(self, config: ProjectConfig):\n",
        "        self.config = config\n",
        "        self.extractor = TextExtractor()\n",
        "        self.matching_engine = self._build_matching_engine(config)\n",
        "        self.resume_parser = ResumeParserService(self.extractor)\n",
        "        self.job_parser = JobDescriptionParserService(self.matching_engine)\n",
        "        self.ranker = CandidateRankingService()\n",
        "        self.writer = OutputWriter(config)\n",
        "\n",
        "    def run(self) -> List[CandidateMatchResult]:\n",
        "        logger.info(\"Starting CV sorting pipeline\")\n",
        "\n",
        "        resumes = self.resume_parser.parse_resumes(\n",
        "            resumes_dir=self.config.resumes_dir,\n",
        "            max_resumes=self.config.max_resumes,\n",
        "        )\n",
        "        logger.info(\"Parsed %s resumes\", len(resumes))\n",
        "\n",
        "        job_description = self.job_parser.parse_job_description(self.config.job_description_path)\n",
        "        logger.info(\"Parsed job description for role: %s\", job_description.title)\n",
        "\n",
        "        results = []\n",
        "        for resume in resumes:\n",
        "            logger.info(\"Evaluating candidate file: %s\", resume.file_name)\n",
        "            result = self.matching_engine.evaluate_candidate(resume, job_description)\n",
        "            results.append(result)\n",
        "\n",
        "        ranked_results = self.ranker.rank_candidates(results)\n",
        "        self.writer.write_all(ranked_results)\n",
        "        logger.info(\"Ranking files generated in %s\", self.config.output_dir)\n",
        "        return ranked_results\n",
        "\n",
        "    def _build_matching_engine(self, config: ProjectConfig) -> MatchingEngine:\n",
        "        backend = config.llm_backend.lower().strip()\n",
        "        if backend == \"ollama\":\n",
        "            return OllamaLLMEngine(\n",
        "                model_name=config.ollama_model,\n",
        "                temperature=config.temperature,\n",
        "            )\n",
        "        return HeuristicLLMEngine()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CLI\n",
        "# ============================================================\n",
        "\n",
        "def parse_args(args: Optional[List[str]] = None) -> argparse.Namespace:\n",
        "    parser = argparse.ArgumentParser(description=\"CV Sorting using LLMs\")\n",
        "    parser.add_argument(\"--resumes_dir\", default=\"data/resumes\", help=\"Directory containing resume files\")\n",
        "    parser.add_argument(\"--job_description\", default=\"data/job_description.txt\", help=\"Path to job description file\")\n",
        "    parser.add_argument(\"--output_dir\", default=\"output\", help=\"Directory to write ranked output files\")\n",
        "    parser.add_argument(\"--llm_backend\", default=\"heuristic\", choices=[\"heuristic\", \"ollama\"], help=\"Matching backend\")\n",
        "    parser.add_argument(\"--ollama_model\", default=\"llama3.1:8b\", help=\"Ollama model name\")\n",
        "    parser.add_argument(\"--temperature\", type=float, default=0.1, help=\"LLM temperature\")\n",
        "    parser.add_argument(\"--max_resumes\", type=int, default=10, help=\"Maximum number of resumes to process\")\n",
        "    return parser.parse_args(args=args)\n",
        "\n",
        "\n",
        "def build_config_from_args(args: argparse.Namespace) -> ProjectConfig:\n",
        "    return ProjectConfig(\n",
        "        resumes_dir=args.resumes_dir,\n",
        "        job_description_path=args.job_description,\n",
        "        output_dir=args.output_dir,\n",
        "        llm_backend=args.llm_backend,\n",
        "        ollama_model=args.ollama_model,\n",
        "        temperature=args.temperature,\n",
        "        max_resumes=args.max_resumes,\n",
        "    )\n",
        "\n",
        "\n",
        "def main() -> None:\n",
        "    # Ensure necessary directories and dummy files exist for the pipeline to run\n",
        "    data_dir = Path(\"data\")\n",
        "    resumes_dir = data_dir / \"resumes\"\n",
        "    job_description_path = data_dir / \"job_description.txt\"\n",
        "\n",
        "    data_dir.mkdir(exist_ok=True)\n",
        "    resumes_dir.mkdir(exist_ok=True)\n",
        "\n",
        "    # Create a dummy job description file if it doesn't exist\n",
        "    if not job_description_path.exists():\n",
        "        job_description_content = \"\"\"\n",
        "        Job Title: Software Engineer\n",
        "        Required Skills: Python, SQL, Cloud (AWS or GCP)\n",
        "        Preferred Skills: Docker, Kubernetes, Machine Learning\n",
        "        Responsibilities: Develop and maintain software, work with data pipelines.\n",
        "        Qualifications: Bachelor's degree in Computer Science, 3+ years of experience.\n",
        "        \"\"\"\n",
        "        job_description_path.write_text(job_description_content)\n",
        "        logger.info(f\"Created dummy job description at: {job_description_path}\")\n",
        "\n",
        "    # Create a dummy resume file if it doesn't exist\n",
        "    dummy_resume_path = resumes_dir / \"john_doe_resume.txt\"\n",
        "    if not dummy_resume_path.exists():\n",
        "        resume_content = \"\"\"\n",
