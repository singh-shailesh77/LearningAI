# Interactive Filtering Support
# ============================================================

class QueryRefinementService:
    def filter_candidates(
        self,
        ranked_results: List[CandidateMatchResult],
        required_skills: List[str],
        minimum_score: float = 0.0,
    ) -> List[CandidateMatchResult]:
        required = {skill.lower() for skill in required_skills}
        filtered = []
        for result in ranked_results:
            candidate_skills = {skill.lower() for skill in result.matched_skills}
            if required.issubset(candidate_skills) and result.overall_score >= minimum_score:
                filtered.append(result)
        return filtered


