        ...

    def evaluate_candidate(
        self,
        resume: ResumeData,
        job_description: JobDescriptionData,
    ) -> CandidateMatchResult:
        ...


class HeuristicLLMEngine:
    """
    Offline-friendly engine that imitates LLM-style reasoning using deterministic scoring.
    Useful for capstone demos when an actual open-source LLM is unavailable.
    """

    COMMON_SKILLS = {
        "python", "java", "sql", "mongodb", "postgresql", "mysql", "aws", "azure",
        "gcp", "docker", "kubernetes", "git", "github", "linux", "fastapi", "flask",
        "django", "pandas", "numpy", "scikit-learn", "tensorflow", "pytorch", "spark",
        "hadoop", "nlp", "machine learning", "deep learning", "transformers", "langchain",
        "llm", "llms", "prompt engineering", "rag", "llamaindex", "data analysis",
        "power bi", "tableau", "excel", "communication", "leadership", "streamlit"
    }

    PRIORITY_WEIGHTS = {
        "high": 1.5,
        "medium": 1.0,
        "low": 0.6,
    }

    def parse_job_description(self, raw_text: str) -> JobDescriptionData:
        title = self._extract_title(raw_text)
        bullet_lines = self._extract_bullets(raw_text)
        normalized_text = self._normalize_space(raw_text.lower())
        skills = sorted(self._extract_skills(normalized_text))

        required_skills = []
        preferred_skills = []
        responsibilities = []
        qualifications = []
        requirements = []

        for line in bullet_lines:
            lower = line.lower()
            if any(token in lower for token in ["must", "required", "mandatory"]):
                qualifications.append(line)
                found_skills = self._extract_skills(lower)
                required_skills.extend(found_skills)
                requirements.append(
                    JobRequirement(
                        requirement=line,
                        category=self._infer_requirement_category(line),
                        priority="high",
                        weight=1.5,
                    )
                )
            elif any(token in lower for token in ["preferred", "good to have", "nice to have", "plus"]):
                qualifications.append(line)
                found_skills = self._extract_skills(lower)
                preferred_skills.extend(found_skills)
                requirements.append(
                    JobRequirement(
                        requirement=line,
                        category=self._infer_requirement_category(line),
                        priority="medium",
                        weight=1.0,
                    )
                )
            elif any(token in lower for token in ["responsible", "responsibilities", "design", "develop", "build", "deploy", "maintain"]):
                responsibilities.append(line)
                requirements.append(
                    JobRequirement(
                        requirement=line,
                        category="responsibility",
                        priority="medium",
                        weight=1.0,
                    )
                )
            else:
                found_skills = self._extract_skills(lower)
                if found_skills:
                    required_skills.extend(found_skills)
                requirements.append(
                    JobRequirement(
                        requirement=line,
                        category=self._infer_requirement_category(line),
                        priority="medium",
                        weight=1.0,
                    )
                )

        if not requirements:
            for sentence in self._split_sentences(raw_text):
                sentence = sentence.strip()
                if not sentence:
                    continue
                requirements.append(
                    JobRequirement(
                        requirement=sentence,
                        category=self._infer_requirement_category(sentence),
                        priority="medium",
                        weight=1.0,
                    )
                )

        required_skills = sorted(set(required_skills or skills))
        preferred_skills = sorted(set(preferred_skills))
        keywords = sorted(set(skills + required_skills + preferred_skills))

        return JobDescriptionData(
            title=title,
            required_skills=required_skills,
            preferred_skills=preferred_skills,
            responsibilities=responsibilities,
            qualifications=qualifications,
            keywords=keywords,
            requirements=requirements,
            raw_text=raw_text,
        )

    def evaluate_candidate(
        self,
        resume: ResumeData,
        job_description: JobDescriptionData,
    ) -> CandidateMatchResult:
        matched_skills = sorted(set(resume.skills) & set(job_description.required_skills + job_description.preferred_skills))
        missing_skills = sorted(set(job_description.required_skills) - set(resume.skills))

        requirement_scores: List[RequirementScore] = []
        weighted_total = 0.0
        weighted_max = 0.0

        for requirement in job_description.requirements:
            score, evidence, gap = self._score_requirement(requirement, resume)
            max_score = 10.0
            weight = requirement.weight * self.PRIORITY_WEIGHTS.get(requirement.priority, 1.0)
            weighted_total += score * weight
            weighted_max += max_score * weight
            requirement_scores.append(
                RequirementScore(
                    requirement=requirement.requirement,
                    category=requirement.category,
                    score=round(score, 2),
                    max_score=max_score,
                    evidence=evidence,
                    gap=gap,
                )
            )

        skill_coverage = 0.0
        if job_description.required_skills:
            skill_coverage = len(set(resume.skills) & set(job_description.required_skills)) / len(set(job_description.required_skills))

        experience_bonus = min(resume.experience_years / 8.0, 1.0) * 10.0
        blended_score = ((weighted_total / weighted_max) * 90.0) + experience_bonus if weighted_max else experience_bonus
        blended_score += skill_coverage * 10.0
        overall_score = min(round(blended_score, 2), 100.0)

        recommendation = self._recommendation(overall_score)
        summary = self._build_summary(
            resume=resume,
            job_description=job_description,
            matched_skills=matched_skills,
            missing_skills=missing_skills,
            overall_score=overall_score,
        )

        return CandidateMatchResult(
            rank=0,
            candidate_id=resume.candidate_id,
            file_name=resume.file_name,
            candidate_name=resume.name,
            overall_score=overall_score,
            recommendation=recommendation,
            matched_skills=matched_skills,
            missing_skills=missing_skills,
            experience_years=resume.experience_years,
            summary=summary,
            requirement_scores=requirement_scores,
        )

    def _score_requirement(self, requirement: JobRequirement, resume: ResumeData) -> tuple[float, str, str]:
        requirement_text = requirement.requirement.lower()
        resume_text = resume.raw_text.lower()
        requirement_skills = self._extract_skills(requirement_text)

        if requirement_skills:
            matched = sorted(set(requirement_skills) & set(resume.skills))
            missing = sorted(set(requirement_skills) - set(resume.skills))
            ratio = len(matched) / len(requirement_skills)
            score = ratio * 10.0
            evidence = (
                f"Matched skills: {', '.join(matched)}"
                if matched else
                "No explicit matching skill found in resume."
            )
            gap = (
                f"Missing skills: {', '.join(missing)}"
                if missing else
                "No major skill gap for this requirement."
            )
            return score, evidence, gap

        overlap_tokens = self._token_overlap(requirement_text, resume_text)
        if overlap_tokens >= 8:
            return 8.0, "Strong textual alignment with candidate experience.", "No obvious gap detected."
        if overlap_tokens >= 4:
            return 6.0, "Moderate alignment found in resume narrative.", "More direct evidence could strengthen fit."
        if overlap_tokens >= 2:
            return 4.0, "Partial relevance found in resume content.", "Requirement is not strongly demonstrated."
        return 2.0, "Very limited evidence found for this requirement.", "Requirement appears weakly supported in the resume."

    def _build_summary(
        self,
        resume: ResumeData,
        job_description: JobDescriptionData,
        matched_skills: List[str],
        missing_skills: List[str],
        overall_score: float,
    ) -> str:
        matched_part = ", ".join(matched_skills[:6]) if matched_skills else "limited direct skill overlap"
        missing_part = ", ".join(missing_skills[:5]) if missing_skills else "no major required skill gaps"
        return (
            f"{resume.name} shows {resume.experience_years:.1f} years of estimated experience. "
            f"The profile aligns with the role through {matched_part}. "
            f"The main gaps are {missing_part}. "
            f"Overall fit is assessed at {overall_score}/100 for the target role '{job_description.title}'."
        )

    def _recommendation(self, score: float) -> str:
        if score >= 80:
            return "Strong Fit"
        if score >= 60:
            return "Moderate Fit"
        return "Weak Fit"

    def _extract_title(self, raw_text: str) -> str:
        lines = [line.strip() for line in raw_text.splitlines() if line.strip()]
        return lines[0] if lines else "Job Role"

    def _extract_bullets(self, raw_text: str) -> List[str]:
        lines = [line.strip(" -•\t") for line in raw_text.splitlines() if line.strip()]
        bullets = [line for line in lines if len(line.split()) >= 3]
        return bullets

    def _extract_skills(self, text: str) -> set[str]:
        found = set()
        for skill in self.COMMON_SKILLS:
            if skill in text:
                found.add(skill)
        return found

    def _infer_requirement_category(self, text: str) -> str:
        lower = text.lower()
        if any(token in lower for token in ["skill", "python", "sql", "llm", "langchain", "aws", "docker"]):
            return "skill"
        if any(token in lower for token in ["year", "experience"]):
            return "experience"
        if any(token in lower for token in ["degree", "bachelor", "master", "education"]):
            return "education"
        if any(token in lower for token in ["responsible", "design", "develop", "build", "deploy"]):
            return "responsibility"
        return "general"

    def _split_sentences(self, text: str) -> List[str]:
        return re.split(r"(?<=[.!?])\s+", self._normalize_space(text))

    def _normalize_space(self, text: str) -> str:
        return re.sub(r"\s+", " ", text).strip()

    def _token_overlap(self, a: str, b: str) -> int:
        stop = {"the", "and", "or", "to", "of", "for", "with", "in", "a", "an", "on", "is", "are"}
        tokens_a = {t for t in re.findall(r"[a-zA-Z]{3,}", a) if t not in stop}
        tokens_b = {t for t in re.findall(r"[a-zA-Z]{3,}", b) if t not in stop}
        return len(tokens_a & tokens_b)


class OllamaLLMEngine(HeuristicLLMEngine):
    """
    Uses an Ollama-hosted open-source LLM for JD parsing and candidate evaluation.
    Falls back to heuristic processing if the model response is invalid.
    """

    def __init__(self, model_name: str, temperature: float = 0.1):
        self.model_name = model_name
        self.temperature = temperature
        try:
            import requests
        except ImportError as exc:
            raise ImportError("requests is required for Ollama backend.") from exc
        self.requests = requests

    def parse_job_description(self, raw_text: str) -> JobDescriptionData:
        prompt = self._job_description_prompt(raw_text)
        response = self._generate(prompt)
        payload = self._safe_json(response)
        if not payload:
            return super().parse_job_description(raw_text)

        requirements = []
        for item in payload.get("requirements", []):
            if not item.get("requirement"):
                continue
            requirements.append(
                JobRequirement(
                    requirement=item.get("requirement", ""),
                    category=item.get("category", "general"),
                    priority=item.get("priority", "medium"),
                    weight=float(item.get("weight", 1.0)),
                )
            )

        return JobDescriptionData(
            title=payload.get("title", "Job Role"),
            required_skills=self._normalize_list(payload.get("required_skills", [])),
            preferred_skills=self._normalize_list(payload.get("preferred_skills", [])),
            responsibilities=self._normalize_list(payload.get("responsibilities", [])),
            qualifications=self._normalize_list(payload.get("qualifications", [])),
            keywords=self._normalize_list(payload.get("keywords", [])),
            requirements=requirements or super().parse_job_description(raw_text).requirements,
            raw_text=raw_text,
        )

    def evaluate_candidate(
        self,
        resume: ResumeData,
        job_description: JobDescriptionData,
    ) -> CandidateMatchResult:
        prompt = self._candidate_evaluation_prompt(resume, job_description)
        response = self._generate(prompt)
        payload = self._safe_json(response)
        if not payload:
            return super().evaluate_candidate(resume, job_description)

        requirement_scores = []
        for item in payload.get("requirement_scores", []):
            requirement_scores.append(
                RequirementScore(
                    requirement=item.get("requirement", ""),
                    category=item.get("category", "general"),
                    score=float(item.get("score", 0)),
                    max_score=float(item.get("max_score", 10)),
                    evidence=item.get("evidence", ""),
                    gap=item.get("gap", ""),
                )
            )

        return CandidateMatchResult(
            rank=0,
            candidate_id=resume.candidate_id,
            file_name=resume.file_name,
            candidate_name=payload.get("candidate_name", resume.name),
            overall_score=float(payload.get("overall_score", 0)),
            recommendation=payload.get("recommendation", "Moderate Fit"),
            matched_skills=self._normalize_list(payload.get("matched_skills", [])),
            missing_skills=self._normalize_list(payload.get("missing_skills", [])),
            experience_years=resume.experience_years,
            summary=payload.get("summary", ""),
            requirement_scores=requirement_scores,
        )

    def _generate(self, prompt: str) -> str:
        response = self.requests.post(
            "http://localhost:11434/api/generate",
            json={
                "model": self.model_name,
                "prompt": prompt,
                "stream": False,
                "options": {"temperature": self.temperature},
            },
            timeout=120,
        )
        response.raise_for_status()
        data = response.json()
        return data.get("response", "")

    def _job_description_prompt(self, raw_text: str) -> str:
        return f"""
You are a recruitment analyst.
Extract structured job data and return JSON only.
Schema:
{{
  "title": "string",
  "required_skills": ["string"],
  "preferred_skills": ["string"],
  "responsibilities": ["string"],
  "qualifications": ["string"],
  "keywords": ["string"],
  "requirements": [
    {{"requirement": "string", "category": "string", "priority": "high|medium|low", "weight": 1.0}}
  ]
}}
Job Description:
{raw_text}
""".strip()

    def _candidate_evaluation_prompt(self, resume: ResumeData, job_description: JobDescriptionData) -> str:
        return f"""
You are an expert resume screener.
Evaluate the candidate against the job description and return JSON only.
Use only the provided data.
Schema:
{{
  "candidate_name": "string",
  "overall_score": 0,
  "recommendation": "Strong Fit|Moderate Fit|Weak Fit",
  "matched_skills": ["string"],
  "missing_skills": ["string"],
  "summary": "string",
  "requirement_scores": [
    {{
      "requirement": "string",
      "category": "string",
      "score": 0,
      "max_score": 10,
      "evidence": "string",
      "gap": "string"
    }}
  ]
}}
Job Description JSON:
{json.dumps(asdict(job_description), indent=2)}
Resume JSON:
{json.dumps(asdict(resume), indent=2)}
""".strip()

    def _safe_json(self, text: str) -> Dict[str, Any]:
        try:
            match = re.search(r"\{.*\}", text, re.DOTALL)
            if match:
                text = match.group(0)
            return json.loads(text)
        except Exception:
            logger.warning("Invalid JSON from Ollama. Falling back to heuristic engine.")
            return {}

    def _normalize_list(self, value: Any) -> List[str]:
        if isinstance(value, list):
            return [str(v).strip() for v in value if str(v).strip()]
        if isinstance(value, str):
            return [part.strip() for part in re.split(r"[,;\n]", value) if part.strip()]
        return []


