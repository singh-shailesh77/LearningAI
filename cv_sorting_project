# Main Pipeline
# ============================================================

class CVSortingPipeline:
    def __init__(self, config: ProjectConfig):
        self.config = config
        self.extractor = TextExtractor()
        self.matching_engine = self._build_matching_engine(config)
        self.resume_parser = ResumeParserService(self.extractor)
        self.job_parser = JobDescriptionParserService(self.matching_engine)
        self.ranker = CandidateRankingService()
        self.writer = OutputWriter(config)

    def run(self) -> List[CandidateMatchResult]:
        logger.info("Starting CV sorting pipeline")

        resumes = self.resume_parser.parse_resumes(
            resumes_dir=self.config.resumes_dir,
            max_resumes=self.config.max_resumes,
        )
        logger.info("Parsed %s resumes", len(resumes))

        job_description = self.job_parser.parse_job_description(self.config.job_description_path)
        logger.info("Parsed job description for role: %s", job_description.title)

        results = []
        for resume in resumes:
            logger.info("Evaluating candidate file: %s", resume.file_name)
            result = self.matching_engine.evaluate_candidate(resume, job_description)
            results.append(result)

        ranked_results = self.ranker.rank_candidates(results)
        self.writer.write_all(ranked_results)
        logger.info("Ranking files generated in %s", self.config.output_dir)
        return ranked_results

    def _build_matching_engine(self, config: ProjectConfig) -> MatchingEngine:
        backend = config.llm_backend.lower().strip()
        if backend == "ollama":
            return OllamaLLMEngine(
                model_name=config.ollama_model,
                temperature=config.temperature,
            )
        return HeuristicLLMEngine()


