def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="CV Sorting using LLMs")
    parser.add_argument("--resumes_dir", default="data/resumes", help="Directory containing resume files")
    parser.add_argument("--job_description", default="data/job_description.txt", help="Path to job description file")
    parser.add_argument("--output_dir", default="output", help="Directory to write ranked output files")
    parser.add_argument("--llm_backend", default="heuristic", choices=["heuristic", "ollama"], help="Matching backend")
    parser.add_argument("--ollama_model", default="llama3.1:8b", help="Ollama model name")
    parser.add_argument("--temperature", type=float, default=0.1, help="LLM temperature")
    parser.add_argument("--max_resumes", type=int, default=10, help="Maximum number of resumes to process")
    return parser.parse_args()


def build_config_from_args(args: argparse.Namespace) -> ProjectConfig:
    return ProjectConfig(
        resumes_dir=args.resumes_dir,
        job_description_path=args.job_description,
        output_dir=args.output_dir,
        llm_backend=args.llm_backend,
        ollama_model=args.ollama_model,
        temperature=args.temperature,
        max_resumes=args.max_resumes,
    )


def main() -> None:
    # Check if running in an interactive environment (like Colab)
    if 'ipykernel' in sys.modules:
        # Pass an empty list to parse_args() to avoid parsing kernel-specific arguments
        args = parse_args(args=[])
    else:
        args = parse_args()

    config = build_config_from_args(args)
    pipeline = CVSortingPipeline(config)
    ranked_results = pipeline.run()

    print("\nTop candidates:")
    for result in ranked_results[: min(10, len(ranked_results))]:
        print(
            f"#{result.rank} | {result.candidate_name} | "
            f"Score: {result.overall_score} | {result.recommendation}"
        )

    print(f"\nJSON output: {config.ranking_json_path}")
    print(f"CSV output: {config.ranking_csv_path}")
    print(f"Text report: {config.ranking_txt_path}")


if __name__ == "__main__":
    main()
