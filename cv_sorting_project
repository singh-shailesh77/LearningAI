class CandidateRankingService:
    def rank_candidates(self, results: List[CandidateMatchResult]) -> List[CandidateMatchResult]:
        ranked = sorted(results, key=lambda item: item.overall_score, reverse=True)
        for index, result in enumerate(ranked, start=1):
            result.rank = index
        return ranked


class OutputWriter:
    def __init__(self, config: ProjectConfig):
        self.config = config
        Path(config.output_dir).mkdir(parents=True, exist_ok=True)

    def write_all(self, ranked_results: List[CandidateMatchResult]) -> None:
        self._write_json(ranked_results)
        self._write_csv(ranked_results)
        self._write_text_report(ranked_results)

    def _write_json(self, ranked_results: List[CandidateMatchResult]) -> None:
        serializable = []
        for result in ranked_results:
            item = asdict(result)
            serializable.append(item)
        self.config.ranking_json_path.write_text(
            json.dumps(serializable, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )

    def _write_csv(self, ranked_results: List[CandidateMatchResult]) -> None:
        fieldnames = [
            "rank",
            "candidate_id",
            "file_name",
            "candidate_name",
            "overall_score",
            "recommendation",
            "experience_years",
            "matched_skills",
            "missing_skills",
            "summary",
        ]
        with open(self.config.ranking_csv_path, "w", newline="", encoding="utf-8") as file_handle:
            writer = csv.DictWriter(file_handle, fieldnames=fieldnames)
            writer.writeheader()
            for result in ranked_results:
                writer.writerow({
                    "rank": result.rank,
                    "candidate_id": result.candidate_id,
                    "file_name": result.file_name,
                    "candidate_name": result.candidate_name,
                    "overall_score": result.overall_score,
                    "recommendation": result.recommendation,
                    "experience_years": result.experience_years,
                    "matched_skills": "; ".join(result.matched_skills),
                    "missing_skills": "; ".join(result.missing_skills),
                    "summary": result.summary,
                })

    def _write_text_report(self, ranked_results: List[CandidateMatchResult]) -> None:
        lines: List[str] = []
        lines.append("CV Sorting Results")
        lines.append("=" * 80)
        lines.append("")

        for result in ranked_results:
            lines.append(f"Rank #{result.rank}: {result.candidate_name}")
            lines.append(f"File: {result.file_name}")
            lines.append(f"Overall Score: {result.overall_score}")
            lines.append(f"Recommendation: {result.recommendation}")
            lines.append(f"Estimated Experience (years): {result.experience_years}")
            lines.append(f"Matched Skills: {', '.join(result.matched_skills) if result.matched_skills else 'None'}")
            lines.append(f"Missing Skills: {', '.join(result.missing_skills) if result.missing_skills else 'None'}")
            lines.append(f"Summary: {result.summary}")
            lines.append("Requirement Breakdown:")
            for req in result.requirement_scores:
                lines.append(
                    f"  - [{req.category}] {req.requirement} | Score: {req.score}/{req.max_score} | "
                    f"Evidence: {req.evidence} | Gap: {req.gap}"
                )
            lines.append("-" * 80)

        self.config.ranking_txt_path.write_text("\n".join(lines), encoding="utf-8")


